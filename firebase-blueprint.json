      },
      "required": [
        "shopId", "ownerId", "name", "code", "address", "phone",
        "managerName", "isActive", "createdAt", "updatedAt"
      ]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "A wholesale distributor or FMCG company supplying stock with cash & due payable ledger.",
      "type": "object",
      "properties": {
        "shopId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
