    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Immutable cash and due/baki accounting ledger entry for customers and suppliers.",
      "type": "object",
      "properties": {
        "shopId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partyType": { "type": "string", "enum": ["customer", "supplier"] },
        "partyId": { "type": "string", "minLength": 1, "maxLength": 128 },
