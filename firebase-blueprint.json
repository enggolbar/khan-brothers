      "required": [
        "shopId", "ownerId", "branchName", "cashierName", "openingCash",
        "cashSalesTotal", "mfsCardSalesTotal", "cashExpensesTotal", "expectedCash",
        "countedCash", "variance", "status", "notes", "createdAt", "updatedAt"
      ]
    },
    "StaffMember": {
      "title": "StaffMember",
