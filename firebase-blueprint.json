{
  "entities": {
    "Shop": {
      "title": "Shop",
      "description": "A multi-tenant Smart Super Shop & Distributorship workspace (default: M/S Khan Brothers, Rangamati).",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "branchName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "address": { "type": "string", "maxLength": 240 },
        "phone": { "type": "string", "maxLength": 25 },
        "binNumber": { "type": "string", "maxLength": 40 },
        "defaultVatRate": { "type": "number" },
        "receiptFooter": { "type": "string", "maxLength": 200 },
        "plan": { "type": "string", "enum": ["starter", "growth", "enterprise"] },
        "currency": { "type": "string", "enum": ["BDT"] },
        "invoiceCounter": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "name", "branchName", "address", "phone", "binNumber",
        "defaultVatRate", "receiptFooter", "plan", "currency", "invoiceCounter",
        "createdAt", "updatedAt"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "An inventory SKU sellable on the supermarket POS and distribution SR portal.",
      "type": "object",
      "properties": {
        "shopId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "barcode": { "type": "string", "minLength": 1, "maxLength": 48 },
        "sku": { "type": "string", "minLength": 1, "maxLength": 40 },
        "category": { "type": "string", "minLength": 1, "maxLength": 50 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 20 },
        "costPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "vatRate": { "type": "number" },
        "stock": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "shopId", "ownerId", "name", "barcode", "sku", "category", "unit",
        "costPrice", "sellingPrice", "vatRate", "stock", "reorderLevel",
        "isActive", "createdAt", "updatedAt"
      ]
    },
    "Sale": {
      "title": "Sale",
      "description": "A completed, held, refunded, or voided POS invoice supporting cash, MFS, and customer credit/due.",
      "type": "object",
      "properties": {
        "shopId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invoiceNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
        "cashierName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "branchName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 25 },
        "items": { "type": "array" },
        "itemCount": { "type": "number" },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "vatAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "changeAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "bkash", "nagad", "rocket", "card", "split", "credit"] },
        "paymentRef": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["completed", "held", "refunded", "voided"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "shopId", "ownerId", "invoiceNumber", "cashierName", "branchName",
        "customerId", "customerName", "customerPhone", "items", "itemCount",
        "subtotal", "discountAmount", "vatAmount", "totalAmount", "paidAmount",
        "changeAmount", "paymentMethod", "paymentRef", "status",
        "createdAt", "updatedAt"
      ]
    },
    "Customer": {
      "title": "Customer",
      "description": "A supermarket customer or distribution retailer shop with due/baki balance and loyalty points.",
      "type": "object",
      "properties": {
        "shopId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "shopName": { "type": "string", "maxLength": 100 },
        "marketArea": { "type": "string", "maxLength": 100 },
        "customerType": { "type": "string", "enum": ["retail", "wholesale"] },
        "phone": { "type": "string", "minLength": 1, "maxLength": 25 },
        "address": { "type": "string", "maxLength": 200 },
        "loyaltyPoints": { "type": "number" },
        "totalSpent": { "type": "number" },
        "visitCount": { "type": "number" },
        "balanceDue": { "type": "number" },
        "creditLimit": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "shopId", "ownerId", "name", "phone", "address",
        "loyaltyPoints", "totalSpent", "visitCount", "createdAt", "updatedAt"
      ]
    },
    "Branch": {
      "title": "Branch",
      "description": "A physical retail branch or counter register under a shop tenant.",
      "type": "object",
      "properties": {
        "shopId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "code": { "type": "string", "minLength": 1, "maxLength": 20 },
