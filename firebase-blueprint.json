  "firestore": {
    "/shops/{shopId}": { "schema": { "$ref": "#/entities/Shop" }, "description": "Tenant shop & distributorship profile." },
    "/shops/{shopId}/products/{productId}": { "schema": { "$ref": "#/entities/Product" }, "description": "Inventory catalog & stock." },
    "/shops/{shopId}/sales/{saleId}": { "schema": { "$ref": "#/entities/Sale" }, "description": "Supermarket POS invoices & credit sales." },
    "/shops/{shopId}/customers/{customerId}": { "schema": { "$ref": "#/entities/Customer" }, "description": "Supermarket customers & retail shops with due/baki balances." },
    "/shops/{shopId}/branches/{branchId}": { "schema": { "$ref": "#/entities/Branch" }, "description": "Store outlets & warehouses." },
    "/shops/{shopId}/suppliers/{supplierId}": { "schema": { "$ref": "#/entities/Supplier" }, "description": "Suppliers & distributors with cash/due payables." },
    "/shops/{shopId}/purchases/{purchaseId}": { "schema": { "$ref": "#/entities/PurchaseOrder" }, "description": "Stock procurement orders." },
    "/shops/{shopId}/expenses/{expenseId}": { "schema": { "$ref": "#/entities/Expense" }, "description": "Daily operating expenses." },
    "/shops/{shopId}/shifts/{shiftId}": { "schema": { "$ref": "#/entities/Shift" }, "description": "Cash register shift records." },
    "/shops/{shopId}/staff/{staffId}": { "schema": { "$ref": "#/entities/StaffMember" }, "description": "Staff & Field SR roster." },
    "/shops/{shopId}/srOrders/{orderId}": { "schema": { "$ref": "#/entities/SrOrder" }, "description": "Field SR sales orders, deliveries, and commission records." },
    "/shops/{shopId}/ledgerEntries/{entryId}": { "schema": { "$ref": "#/entities/LedgerEntry" }, "description": "Customer Baki & Supplier Cash/Due audit ledger." }
  }
}
