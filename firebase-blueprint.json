    "Shift": {
      "title": "Shift",
      "description": "A POS cash register shift with opening float, counted cash, and variance reconciliation.",
      "type": "object",
      "properties": {
        "shopId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "branchName": { "type": "string", "minLength": 1, "maxLength": 80 },
