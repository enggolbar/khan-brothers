# Hostinger database env var names shown in hPanel. Keep values in hPanel/.env only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u857660968_anz_website
DB_USER=your_database_user
DB_PASS=replace_with_a_strong_password

# App login and first super-admin account. Generate SESSION_SECRET with a long random value.
SESSION_SECRET=replace_with_a_long_random_secret
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Hostinger assigns PORT automatically.
