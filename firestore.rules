rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Security Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'enggolbar@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function shopExists(shopId) {
      return exists(/databases/$(database)/documents/shops/$(shopId));
    }

    function isShopOwner(shopId) {
      return shopExists(shopId) &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidShop(data) {
      return data.keys().hasAll([
          'ownerId', 'name', 'branchName', 'address', 'phone', 'binNumber',
          'defaultVatRate', 'receiptFooter', 'plan', 'currency', 'invoiceCounter',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'name', 'branchName', 'address', 'phone', 'binNumber',
          'defaultVatRate', 'receiptFooter', 'plan', 'currency', 'invoiceCounter',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80 &&
        data.address is string && data.address.size() <= 240 &&
        data.phone is string && data.phone.size() <= 25 &&
        data.binNumber is string && data.binNumber.size() <= 40 &&
        data.defaultVatRate is number && data.defaultVatRate >= 0 && data.defaultVatRate <= 30 &&
        data.receiptFooter is string && data.receiptFooter.size() <= 200 &&
        data.plan is string && data.plan.size() <= 20 && data.plan in ['starter', 'growth', 'enterprise'] &&
        data.currency is string && data.currency.size() <= 10 && data.currency == 'BDT' &&
        data.invoiceCounter is number && data.invoiceCounter >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data, shopId) {
      return data.keys().hasAll([
          'shopId', 'ownerId', 'name', 'barcode', 'sku', 'category', 'unit',
          'costPrice', 'sellingPrice', 'vatRate', 'stock', 'reorderLevel',
          'isActive', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shopId', 'ownerId', 'name', 'barcode', 'sku', 'category', 'unit',
          'costPrice', 'sellingPrice', 'vatRate', 'stock', 'reorderLevel',
          'isActive', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.shopId) && data.shopId == shopId &&
        isValidId(data.ownerId) && (data.ownerId == request.auth.uid || isAdmin()) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.barcode is string && data.barcode.size() >= 1 && data.barcode.size() <= 48 &&
        data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 40 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
        data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 20 &&
        data.costPrice is number && data.costPrice >= 0 && data.costPrice <= 10000000 &&
        data.sellingPrice is number && data.sellingPrice >= 0 && data.sellingPrice <= 10000000 &&
        data.vatRate is number && data.vatRate >= 0 && data.vatRate <= 30 &&
        data.stock is number && data.stock >= 0 && data.stock <= 10000000 &&
        data.reorderLevel is number && data.reorderLevel >= 0 && data.reorderLevel <= 1000000 &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSale(data, shopId) {
      return data.keys().hasAll([
          'shopId', 'ownerId', 'invoiceNumber', 'cashierName', 'branchName',
          'customerId', 'customerName', 'customerPhone', 'items', 'itemCount',
          'subtotal', 'discountAmount', 'vatAmount', 'totalAmount', 'paidAmount',
          'changeAmount', 'paymentMethod', 'paymentRef', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shopId', 'ownerId', 'invoiceNumber', 'cashierName', 'branchName',
          'customerId', 'customerName', 'customerPhone', 'items', 'itemCount',
          'subtotal', 'discountAmount', 'vatAmount', 'totalAmount', 'paidAmount',
          'changeAmount', 'dueAmount', 'paymentMethod', 'paymentRef', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.shopId) && data.shopId == shopId &&
        isValidId(data.ownerId) && (data.ownerId == request.auth.uid || isAdmin()) &&
        data.invoiceNumber is string && data.invoiceNumber.size() >= 1 && data.invoiceNumber.size() <= 40 &&
        data.cashierName is string && data.cashierName.size() >= 1 && data.cashierName.size() <= 80 &&
        data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80 &&
        data.customerId is string && data.customerId.size() <= 128 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
        data.customerPhone is string && data.customerPhone.size() <= 25 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map &&
        data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 10000 &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.discountAmount is number && data.discountAmount >= 0 &&
        data.vatAmount is number && data.vatAmount >= 0 &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.paidAmount is number && data.paidAmount >= 0 &&
        data.changeAmount is number && data.changeAmount >= 0 &&
        (!('dueAmount' in data) || (data.dueAmount is number && data.dueAmount >= 0)) &&
        data.paymentMethod is string && data.paymentMethod.size() <= 20 &&
        data.paymentMethod in ['cash', 'bkash', 'nagad', 'rocket', 'card', 'split', 'credit'] &&
        data.paymentRef is string && data.paymentRef.size() <= 60 &&
        data.status is string && data.status.size() <= 20 &&
        data.status in ['completed', 'held', 'refunded', 'voided'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomer(data, shopId) {
      return data.keys().hasAll([
          'shopId', 'ownerId', 'name', 'phone', 'address',
          'loyaltyPoints', 'totalSpent', 'visitCount', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shopId', 'ownerId', 'name', 'shopName', 'marketArea', 'customerType',
          'phone', 'address', 'loyaltyPoints', 'totalSpent', 'visitCount',
          'balanceDue', 'creditLimit', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.shopId) && data.shopId == shopId &&
        isValidId(data.ownerId) && (data.ownerId == request.auth.uid || isAdmin()) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        (!('shopName' in data) || (data.shopName is string && data.shopName.size() <= 100)) &&
        (!('marketArea' in data) || (data.marketArea is string && data.marketArea.size() <= 100)) &&
        (!('customerType' in data) || (data.customerType is string && data.customerType.size() <= 20 && data.customerType in ['retail', 'wholesale'])) &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 25 &&
        data.address is string && data.address.size() <= 200 &&
        data.loyaltyPoints is number && data.loyaltyPoints >= 0 &&
        data.totalSpent is number && data.totalSpent >= 0 &&
        data.visitCount is number && data.visitCount >= 0 &&
        (!('balanceDue' in data) || (data.balanceDue is number && data.balanceDue >= 0)) &&
        (!('creditLimit' in data) || (data.creditLimit is number && data.creditLimit >= 0)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBranch(data, shopId) {
      return data.keys().hasAll([
          'shopId', 'ownerId', 'name', 'code', 'address', 'phone',
          'managerName', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shopId', 'ownerId', 'name', 'code', 'address', 'phone',
          'managerName', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.shopId) && data.shopId == shopId &&
        isValidId(data.ownerId) && (data.ownerId == request.auth.uid || isAdmin()) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 20 &&
        data.address is string && data.address.size() <= 200 &&
        data.phone is string && data.phone.size() <= 25 &&
        data.managerName is string && data.managerName.size() <= 80 &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSupplier(data, shopId) {
      return data.keys().hasAll([
          'shopId', 'ownerId', 'name', 'company', 'phone', 'address',
          'category', 'totalPurchased', 'balanceDue', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shopId', 'ownerId', 'name', 'company', 'phone', 'address',
          'category', 'totalPurchased', 'balanceDue', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.shopId) && data.shopId == shopId &&
        isValidId(data.ownerId) && (data.ownerId == request.auth.uid || isAdmin()) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.company is string && data.company.size() <= 100 &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 25 &&
        data.address is string && data.address.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
        data.totalPurchased is number && data.totalPurchased >= 0 &&
        data.balanceDue is number && data.balanceDue >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPurchase(data, shopId) {
      return data.keys().hasAll([
          'shopId', 'ownerId', 'poNumber', 'supplierId', 'supplierName', 'branchName',
          'items', 'itemCount', 'totalCost', 'paidAmount', 'status', 'notes',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shopId', 'ownerId', 'poNumber', 'supplierId', 'supplierName', 'branchName',
          'items', 'itemCount', 'totalCost', 'paidAmount', 'status', 'notes',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.shopId) && data.shopId == shopId &&
        isValidId(data.ownerId) && (data.ownerId == request.auth.uid || isAdmin()) &&
        data.poNumber is string && data.poNumber.size() >= 1 && data.poNumber.size() <= 40 &&
        isValidId(data.supplierId) &&
        data.supplierName is string && data.supplierName.size() >= 1 && data.supplierName.size() <= 100 &&
        data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map &&
        data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 100000 &&
        data.totalCost is number && data.totalCost >= 0 &&
        data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= data.totalCost &&
        data.status is string && data.status.size() <= 20 &&
        data.status in ['ordered', 'received', 'cancelled'] &&
        data.notes is string && data.notes.size() <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidExpense(data, shopId) {
      return data.keys().hasAll([
          'shopId', 'ownerId', 'title', 'category', 'amount', 'paymentMethod',
          'branchName', 'reference', 'notes', 'expenseDate', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shopId', 'ownerId', 'title', 'category', 'amount', 'paymentMethod',
          'branchName', 'reference', 'notes', 'expenseDate', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.shopId) && data.shopId == shopId &&
        isValidId(data.ownerId) && (data.ownerId == request.auth.uid || isAdmin()) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
        data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
        data.paymentMethod is string && data.paymentMethod.size() <= 20 &&
        data.paymentMethod in ['cash', 'bkash', 'nagad', 'bank'] &&
        data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80 &&
        data.reference is string && data.reference.size() <= 60 &&
        data.notes is string && data.notes.size() <= 200 &&
        data.expenseDate is string && data.expenseDate.size() >= 1 && data.expenseDate.size() <= 20 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidShift(data, shopId) {
      return data.keys().hasAll([
          'shopId', 'ownerId', 'branchName', 'cashierName', 'openingCash',
          'cashSalesTotal', 'mfsCardSalesTotal', 'cashExpensesTotal', 'expectedCash',
          'countedCash', 'variance', 'status', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shopId', 'ownerId', 'branchName', 'cashierName', 'openingCash',
          'cashSalesTotal', 'mfsCardSalesTotal', 'cashExpensesTotal', 'expectedCash',
          'countedCash', 'variance', 'status', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.shopId) && data.shopId == shopId &&
        isValidId(data.ownerId) && (data.ownerId == request.auth.uid || isAdmin()) &&
        data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80 &&
        data.cashierName is string && data.cashierName.size() >= 1 && data.cashierName.size() <= 80 &&
        data.openingCash is number && data.openingCash >= 0 &&
        data.cashSalesTotal is number && data.cashSalesTotal >= 0 &&
        data.mfsCardSalesTotal is number && data.mfsCardSalesTotal >= 0 &&
        data.cashExpensesTotal is number && data.cashExpensesTotal >= 0 &&
        data.expectedCash is number &&
        data.countedCash is number && data.countedCash >= 0 &&
        data.variance is number &&
        data.status is string && data.status.size() <= 20 &&
        data.status in ['open', 'closed'] &&
        data.notes is string && data.notes.size() <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaff(data, shopId) {
      return data.keys().hasAll([
          'shopId', 'ownerId', 'name', 'phone', 'role', 'branchName',
          'monthlySalary', 'pinCode', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shopId', 'ownerId', 'name', 'phone', 'role', 'branchName',
          'routeArea', 'commissionRate', 'monthlySalary', 'pinCode', 'isActive',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.shopId) && data.shopId == shopId &&
        isValidId(data.ownerId) && (data.ownerId == request.auth.uid || isAdmin()) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 25 &&
        data.role is string && data.role.size() <= 20 &&
        data.role in ['manager', 'cashier', 'inventory', 'accountant', 'sr'] &&
        data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80 &&
        (!('routeArea' in data) || (data.routeArea is string && data.routeArea.size() <= 100)) &&
        (!('commissionRate' in data) || (data.commissionRate is number && data.commissionRate >= 0 && data.commissionRate <= 50)) &&
        data.monthlySalary is number && data.monthlySalary >= 0 && data.monthlySalary <= 10000000 &&
        data.pinCode is string && data.pinCode.size() <= 10 &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSrOrder(data, shopId) {
      return data.keys().hasAll([
          'shopId', 'ownerId', 'orderNumber', 'srId', 'srName', 'routeArea',
          'customerId', 'customerName', 'retailerShopName', 'customerPhone',
          'items', 'itemCount', 'subtotal', 'discountAmount', 'totalAmount',
          'paidAmount', 'dueAmount', 'commissionRate', 'commissionAmount',
          'paymentMethod', 'status', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shopId', 'ownerId', 'orderNumber', 'srId', 'srName', 'routeArea',
          'customerId', 'customerName', 'retailerShopName', 'customerPhone',
          'items', 'itemCount', 'subtotal', 'discountAmount', 'totalAmount',
          'paidAmount', 'dueAmount', 'commissionRate', 'commissionAmount',
          'paymentMethod', 'status', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.shopId) && data.shopId == shopId &&
        isValidId(data.ownerId) && (data.ownerId == request.auth.uid || isAdmin()) &&
        data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 40 &&
        data.srId is string && data.srId.size() <= 128 &&
        data.srName is string && data.srName.size() >= 1 && data.srName.size() <= 100 &&
        data.routeArea is string && data.routeArea.size() <= 100 &&
        data.customerId is string && data.customerId.size() <= 128 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
        data.retailerShopName is string && data.retailerShopName.size() <= 100 &&
        data.customerPhone is string && data.customerPhone.size() <= 25 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map &&
        data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 100000 &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.discountAmount is number && data.discountAmount >= 0 &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.paidAmount is number && data.paidAmount >= 0 &&
        data.dueAmount is number && data.dueAmount >= 0 &&
        data.commissionRate is number && data.commissionRate >= 0 && data.commissionRate <= 50 &&
        data.commissionAmount is number && data.commissionAmount >= 0 &&
        data.paymentMethod is string && data.paymentMethod.size() <= 20 &&
        data.paymentMethod in ['cash', 'bkash', 'nagad', 'rocket', 'card', 'credit'] &&
        data.status is string && data.status.size() <= 20 &&
        data.status in ['pending', 'approved', 'delivered', 'cancelled'] &&
        data.notes is string && data.notes.size() <= 240 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLedgerEntry(data, shopId) {
      return data.keys().hasAll([
          'shopId', 'ownerId', 'partyType', 'partyId', 'partyName', 'entryType',
          'amount', 'paymentMethod', 'reference', 'notes', 'entryDate',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shopId', 'ownerId', 'partyType', 'partyId', 'partyName', 'entryType',
          'amount', 'paymentMethod', 'reference', 'notes', 'entryDate',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.shopId) && data.shopId == shopId &&
        isValidId(data.ownerId) && (data.ownerId == request.auth.uid || isAdmin()) &&
        data.partyType is string && data.partyType.size() <= 20 && data.partyType in ['customer', 'supplier'] &&
        isValidId(data.partyId) &&
        data.partyName is string && data.partyName.size() >= 1 && data.partyName.size() <= 100 &&
        data.entryType is string && data.entryType.size() <= 30 &&
        data.entryType in ['credit_sale', 'sr_delivery', 'customer_collection', 'purchase_due', 'supplier_payment', 'opening_due'] &&
        data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
        data.paymentMethod is string && data.paymentMethod.size() <= 20 &&
        data.paymentMethod in ['cash', 'bkash', 'nagad', 'bank', 'credit'] &&
        data.reference is string && data.reference.size() <= 60 &&
        data.notes is string && data.notes.size() <= 200 &&
        data.entryDate is string && data.entryDate.size() >= 1 && data.entryDate.size() <= 20 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Admin Lookup Collection
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Shops Collection (Master Source of Truth)
    // -------------------------------------------------------------------------
    match /shops/{shopId} {
      allow get: if isSignedIn() && isValidId(shopId) && (
        existing().ownerId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(shopId) &&
        isValidShop(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(shopId) &&
        isValidShop(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'branchName', 'address', 'phone', 'binNumber',
              'defaultVatRate', 'receiptFooter', 'updatedAt'
            ])) ||
          (existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['plan', 'updatedAt'])) ||
          (existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['invoiceCounter', 'updatedAt']) &&
            incoming().invoiceCounter == existing().invoiceCounter + 1)
        );
      allow delete: if isVerifiedUser() && isValidId(shopId) && (
        existing().ownerId == request.auth.uid || isAdmin()
      );

      // Products Subcollection
      match /products/{productId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(productId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(shopId) && isValidId(productId) &&
          isValidProduct(incoming(), shopId) && incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time && isShopOwner(shopId);
        allow update: if isVerifiedUser() && isValidId(shopId) && isValidId(productId) &&
          isValidProduct(incoming(), shopId) &&
          incoming().shopId == existing().shopId && incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          isShopOwner(shopId) && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'barcode', 'sku', 'category', 'unit', 'costPrice',
              'sellingPrice', 'vatRate', 'stock', 'reorderLevel', 'isActive', 'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'costPrice', 'updatedAt'])
          );
        allow delete: if isVerifiedUser() && isValidId(shopId) && isValidId(productId) && (isShopOwner(shopId) || isAdmin());
      }

      // Sales Subcollection
      match /sales/{saleId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(saleId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(shopId) && isValidId(saleId) &&
          isValidSale(incoming(), shopId) && incoming().ownerId == request.auth.uid &&
          incoming().status in ['completed', 'held'] &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time && isShopOwner(shopId);
        allow update: if isVerifiedUser() && isValidId(shopId) && isValidId(saleId) &&
          isValidSale(incoming(), shopId) &&
          incoming().shopId == existing().shopId && incoming().ownerId == existing().ownerId &&
          incoming().invoiceNumber == existing().invoiceNumber &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          isShopOwner(shopId) && (
            isAdmin() ||
            (existing().status == 'completed' && incoming().status == 'refunded' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
            (existing().status == 'held' && incoming().status in ['completed', 'voided'] &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'paymentMethod', 'paymentRef', 'paidAmount', 'dueAmount',
                'changeAmount', 'discountAmount', 'vatAmount', 'totalAmount',
                'customerId', 'customerName', 'customerPhone', 'updatedAt'
              ]))
          );
        allow delete: if isAdmin() && isValidId(shopId) && isValidId(saleId);
      }

      // Customers Subcollection (PII Owner-Isolated + Baki/Due Tracking)
      match /customers/{customerId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(customerId) && (
          (existing().ownerId == request.auth.uid && isShopOwner(shopId)) || isAdmin()
        );
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(shopId) && isValidId(customerId) &&
          isValidCustomer(incoming(), shopId) && incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time && isShopOwner(shopId);
        allow update: if isVerifiedUser() && isValidId(shopId) && isValidId(customerId) &&
          isValidCustomer(incoming(), shopId) &&
          incoming().shopId == existing().shopId && incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          isShopOwner(shopId) && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'shopName', 'marketArea', 'customerType', 'phone', 'address', 'creditLimit', 'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'loyaltyPoints', 'totalSpent', 'visitCount', 'balanceDue', 'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'loyaltyPoints', 'totalSpent', 'visitCount', 'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['balanceDue', 'updatedAt'])
          );
        allow delete: if isVerifiedUser() && isValidId(shopId) && isValidId(customerId) && (isShopOwner(shopId) || isAdmin());
      }

      // Branches Subcollection
      match /branches/{branchId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(branchId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(shopId) && isValidId(branchId) &&
          isValidBranch(incoming(), shopId) && incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time && isShopOwner(shopId);
        allow update: if isVerifiedUser() && isValidId(shopId) && isValidId(branchId) &&
          isValidBranch(incoming(), shopId) &&
          incoming().shopId == existing().shopId && incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          isShopOwner(shopId) && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'code', 'address', 'phone', 'managerName', 'isActive', 'updatedAt'
            ])
          );
        allow delete: if isVerifiedUser() && isValidId(shopId) && isValidId(branchId) && (isShopOwner(shopId) || isAdmin());
      }

      // Suppliers Subcollection (PII Owner-Isolated)
      match /suppliers/{supplierId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(supplierId) && (
          (existing().ownerId == request.auth.uid && isShopOwner(shopId)) || isAdmin()
        );
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(shopId) && isValidId(supplierId) &&
          isValidSupplier(incoming(), shopId) && incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time && isShopOwner(shopId);
        allow update: if isVerifiedUser() && isValidId(shopId) && isValidId(supplierId) &&
          isValidSupplier(incoming(), shopId) &&
          incoming().shopId == existing().shopId && incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          isShopOwner(shopId) && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'company', 'phone', 'address', 'category', 'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['totalPurchased', 'balanceDue', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['balanceDue', 'updatedAt'])
          );
        allow delete: if isVerifiedUser() && isValidId(shopId) && isValidId(supplierId) && (isShopOwner(shopId) || isAdmin());
      }

      // Purchase Orders Subcollection
      match /purchases/{purchaseId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(purchaseId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(shopId) && isValidId(purchaseId) &&
          isValidPurchase(incoming(), shopId) && incoming().ownerId == request.auth.uid &&
          incoming().status in ['ordered', 'received'] &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time && isShopOwner(shopId);
        allow update: if isVerifiedUser() && isValidId(shopId) && isValidId(purchaseId) &&
          isValidPurchase(incoming(), shopId) &&
          incoming().shopId == existing().shopId && incoming().ownerId == existing().ownerId &&
          incoming().poNumber == existing().poNumber &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          isShopOwner(shopId) && (
            isAdmin() ||
            (existing().status == 'ordered' && incoming().status in ['received', 'cancelled'] &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paidAmount', 'updatedAt'])) ||
            (existing().status == 'received' && incoming().status == 'received' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['paidAmount', 'updatedAt']))
          );
        allow delete: if isAdmin() && isValidId(shopId) && isValidId(purchaseId);
      }

      // Operating Expenses Subcollection
      match /expenses/{expenseId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(expenseId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(shopId) && isValidId(expenseId) &&
          isValidExpense(incoming(), shopId) && incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time && isShopOwner(shopId);
        allow update: if isVerifiedUser() && isValidId(shopId) && isValidId(expenseId) &&
          isValidExpense(incoming(), shopId) &&
          incoming().shopId == existing().shopId && incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          isShopOwner(shopId) && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'amount', 'paymentMethod', 'branchName',
              'reference', 'notes', 'expenseDate', 'updatedAt'
            ])
          );
        allow delete: if isVerifiedUser() && isValidId(shopId) && isValidId(expenseId) && (isShopOwner(shopId) || isAdmin());
      }

      // Cash Register Shifts Subcollection
      match /shifts/{shiftId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(shiftId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(shopId) && isValidId(shiftId) &&
          isValidShift(incoming(), shopId) && incoming().ownerId == request.auth.uid &&
          incoming().status == 'open' &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time && isShopOwner(shopId);
        allow update: if isVerifiedUser() && isValidId(shopId) && isValidId(shiftId) &&
          isValidShift(incoming(), shopId) &&
          incoming().shopId == existing().shopId && incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          isShopOwner(shopId) && (
            isAdmin() ||
            (existing().status == 'open' && incoming().status == 'closed' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'cashSalesTotal', 'mfsCardSalesTotal', 'cashExpensesTotal',
                'expectedCash', 'countedCash', 'variance', 'status', 'notes', 'updatedAt'
              ]))
          );
        allow delete: if isAdmin() && isValidId(shopId) && isValidId(shiftId);
      }

      // Staff & Field SR Roster Subcollection (PII Owner-Isolated)
      match /staff/{staffId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(staffId) && (
          (existing().ownerId == request.auth.uid && isShopOwner(shopId)) || isAdmin()
        );
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(shopId) && isValidId(staffId) &&
          isValidStaff(incoming(), shopId) && incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time && isShopOwner(shopId);
        allow update: if isVerifiedUser() && isValidId(shopId) && isValidId(staffId) &&
          isValidStaff(incoming(), shopId) &&
          incoming().shopId == existing().shopId && incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          isShopOwner(shopId) && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'phone', 'role', 'branchName', 'routeArea', 'commissionRate',
              'monthlySalary', 'pinCode', 'isActive', 'updatedAt'
            ])
          );
        allow delete: if isVerifiedUser() && isValidId(shopId) && isValidId(staffId) && (isShopOwner(shopId) || isAdmin());
      }

      // Field SR Sales Orders & Commission Subcollection (Terminal State Locked)
      match /srOrders/{orderId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(orderId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(shopId) && isValidId(orderId) &&
          isValidSrOrder(incoming(), shopId) && incoming().ownerId == request.auth.uid &&
          incoming().status in ['pending', 'approved'] &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time && isShopOwner(shopId);
        allow update: if isVerifiedUser() && isValidId(shopId) && isValidId(orderId) &&
          isValidSrOrder(incoming(), shopId) &&
          incoming().shopId == existing().shopId && incoming().ownerId == existing().ownerId &&
          incoming().orderNumber == existing().orderNumber &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          isShopOwner(shopId) && (
            isAdmin() ||
            (existing().status == 'pending' && incoming().status in ['approved', 'delivered', 'cancelled'] &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'paidAmount', 'dueAmount', 'paymentMethod', 'notes', 'updatedAt'
              ])) ||
            (existing().status == 'approved' && incoming().status in ['delivered', 'cancelled'] &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'paidAmount', 'dueAmount', 'paymentMethod', 'notes', 'updatedAt'
              ]))
          );
        allow delete: if isAdmin() && isValidId(shopId) && isValidId(orderId);
      }

      // Immutable Cash & Due/Baki Ledger Entries
      match /ledgerEntries/{entryId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(entryId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(shopId) && isValidId(entryId) &&
          isValidLedgerEntry(incoming(), shopId) && incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time && isShopOwner(shopId);
        allow update: if isAdmin() && isValidId(shopId) && isValidId(entryId) && isValidLedgerEntry(incoming(), shopId);
        allow delete: if isAdmin() && isValidId(shopId) && isValidId(entryId);
      }
    }
  }
}
